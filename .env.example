# ============================================================
# INSSA Backend Environment Example
# 실제 개발 환경에서는 이 파일을 복사해서 `.env`로 만들고 값을 채우세요.
# 절대 실제 API KEY / SECRET이 들어간 `.env` 파일을 Git에 올리지 마세요.
# ============================================================

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=1209600

# ------------------------------------------------------------
# Google OAuth
# Google Cloud Console > APIs & Services > Credentials
# OAuth 2.0 Client ID 값을 아래에 넣으세요.
# Client ID는 반드시 `.apps.googleusercontent.com`으로 끝나는 값입니다.
# ------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/users/oauth/google/callback

# 아래 alias 이름도 코드에서 지원합니다. 위 값을 쓰면 보통 비워둬도 됩니다.
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/users/oauth/google/callback

# ------------------------------------------------------------
# Kakao OAuth
# Kakao Developers > 내 애플리케이션 > 앱 키/보안 설정 값을 넣으세요.
# ------------------------------------------------------------
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/users/oauth/kakao/callback

# ------------------------------------------------------------
# Django Session / OAuth Debug
# 로컬 개발은 Secure=false, SameSite=Lax 권장.
# HTTPS 배포 환경에서는 SESSION_COOKIE_SECURE=true 권장.
# ------------------------------------------------------------
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
OAUTH_LOG_LEVEL=INFO

# ------------------------------------------------------------
# AI Server Connection
# FastAPI AI 서버를 사용할 거면 true로 설정하세요.
# 현재 개발 기본 포트는 8010입니다.
# 실행 예:
# python -m uvicorn ai_server.main:app --host 127.0.0.1 --port 8010
# ------------------------------------------------------------
AI_SERVER_ENABLED=true
AI_SERVER_BASE_URL=http://localhost:8010

# ------------------------------------------------------------
# LLM Provider
# gemini 또는 openai 중 선택합니다.
# 현재 프로젝트는 Gemini 연동을 기본값으로 사용합니다.
# ------------------------------------------------------------
LLM_PROVIDER=gemini

# ------------------------------------------------------------
# Gemini API
# Google AI Studio에서 발급받은 Gemini API Key를 여기에 넣으세요.
# 여기에 실제 API 키를 넣습니다.
# 예: GEMINI_API_KEY=AIza...
# ------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# OpenAI API
# OpenAI를 사용할 때만 OPENAI_API_KEY를 채우고 LLM_PROVIDER=openai로 바꾸세요.
# 여기에 실제 API 키를 넣습니다.
# 예: OPENAI_API_KEY=sk-...
# ------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
DEFAULT_CHAT_MODEL=gpt-4.1-mini

# ------------------------------------------------------------
# RAG / Vector Search Settings
# ------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
VECTORSTORE_PROVIDER=faiss
RAG_TOP_K=5
RERANK_TOP_K=3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
