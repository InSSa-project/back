# Django
SECRET_KEY=change-me
DEBUG=True

# Database
# Local default: SQLite. Production can set DB_ENGINE=postgres.
DB_ENGINE=sqlite
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
# DB_ENGINE=postgres
# DB_NAME=inssa
# DB_USER=inssa
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# SSAFY admin crawler credentials
# Use an administrator-owned SSAFY account only. Do not commit real values.
SSAFY_CRAWLER_MODE=ssafy_notice
SSAFY_LOGIN_URL=https://edu.ssafy.com/
SSAFY_MAIN_URL=https://edu.ssafy.com/
SSAFY_ID=admin@example.com
SSAFY_PASSWORD=change-me

# SSAFY source list URLs
SSAFY_NOTICE_LIST_URL=https://edu.ssafy.com/edu/board/notice/list.do
SSAFY_RULE_LIST_URL=https://edu.ssafy.com/edu/board/rule/list.do
SSAFY_MENTORING_NOTICE_LIST_URL=https://edu.ssafy.com/edu/board/mentoring/list.do
SSAFY_MENTORING_LIST_URL=https://edu.ssafy.com/edu/board/mentoring/list.do
SSAFY_QUEST_LIST_URL=
SSAFY_CURRICULUM_LIST_URL=
SSAFY_FAQ_LIST_URL=
SSAFY_LEARNING_MATERIAL_LIST_URL=
SSAFY_EVENT_LIST_URL=

# Crawler runtime controls
SSAFY_CRAWLER_SOURCES=notice,mentoring_notice
SSAFY_CRAWLER_SKIP_SOURCES=
SSAFY_NOTICE_MAX_PAGES=2
SSAFY_CRAWLER_RECENT_LIMIT=30
SSAFY_DETAIL_TIMEOUT=10
SSAFY_SOURCE_TIMEOUT=60
SSAFY_CRAWLER_DEBUG_HTML=False

# OCR / AI
OCR_API_KEY=
OPENAI_API_KEY=

# Mattermost
MATTERMOST_BASE_URL=https://meeting.ssafy.com
MATTERMOST_TIMEOUT_SECONDS=5
