# Django deployment
DEBUG=false
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# OAuth: keep real secrets in the deployment platform secret manager
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/users/oauth/google/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/users/oauth/kakao/callback

# Application
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=1209600
AI_SERVER_ENABLED=false
AI_SERVER_BASE_URL=http://localhost:8001
AI_REQUEST_TIMEOUT=20
OAUTH_LOG_LEVEL=INFO
# AI response limits
MAX_COMPLETION_TOKENS=300
MAX_ANSWER_CHARS=700
MAX_SCHEDULE_ANSWER_ITEMS=8


# LLM provider: openai | gemini | http | fastapi | local | fine_tuned
LLM_PROVIDER=gemini
LLM_REQUEST_TIMEOUT=20
LLM_REQUEST_RETRIES=0
# Self-hosted/FastAPI fine-tuned model adapter
LLM_HTTP_BASE_URL=
LLM_HTTP_ENDPOINT=/v1/chat/completions
LLM_HTTP_API_KEY=
LLM_HTTP_MODEL=


