## Django / session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=1209600

## Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/users/oauth/google/callback

## Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/users/oauth/kakao/callback

## AI server
AI_SERVER_ENABLED=false
AI_SERVER_BASE_URL=http://localhost:8001

## LLM
